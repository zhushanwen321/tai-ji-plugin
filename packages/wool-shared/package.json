{
  "name": "@zhushanwen/pi-wool-shared",
  "version": "0.2.0",
  "description": "Shared kernel for wool provider families (@zhushanwen/pi-wool-* pi extensions and @zhushanwen/plugin-wool-* taiji plugins) — credential extraction/decryption, OAuth flows, account/quota/check-in status, model catalog fetch, provider scaffolding, SSE parsing and streamSimple conformance harness. Shared library, not a Pi extension.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts"
    },
    "./qoder": {
      "types": "./src/qoder/index.ts",
      "import": "./src/qoder/index.ts"
    },
    "./trae": {
      "types": "./src/trae/index.ts",
      "import": "./src/trae/index.ts"
    },
    "./workbuddy": {
      "types": "./src/workbuddy/index.ts",
      "import": "./src/workbuddy/index.ts"
    },
    "./plugin": {
      "types": "./src/plugin/index.ts",
      "import": "./src/plugin/index.ts"
    }
  },
  "keywords": [
    "pi-package",
    "pi",
    "wool",
    "provider",
    "shared"
  ],
  "license": "MIT",
  "files": [
    "src/"
  ],
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "typebox": "1.3.27"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typebox": "1.3.27",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhushanwen321/tai-ji-plugin.git",
    "directory": "packages/wool-shared"
  }
}
