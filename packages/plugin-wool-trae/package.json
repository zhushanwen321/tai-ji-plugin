{
  "name": "@zhushanwen/plugin-wool-trae",
  "version": "0.1.0",
  "description": "taiji plugin for the Trae wool provider family — storage.json credential extraction, account status, model catalog refresh.",
  "type": "module",
  "displayName": "Trae (Wool)",
  "main": "src/index.ts",
  "keywords": [
    "taiji-plugin",
    "taiji",
    "wool",
    "trae",
    "provider"
  ],
  "license": "MIT",
  "files": [
    "src/"
  ],
  "taijiPlugin": {
    "manifestVersion": 1,
    "main": "src/index.ts",
    "activationEvents": [
      "onStartupFinished"
    ],
    "capabilities": [
      "network.http",
      "fs.read-user-data",
      "crypto"
    ],
    "readPaths": [
      "Library/Application Support/Trae CN/User/globalStorage/storage.json"
    ],
    "namespace": "wool-trae"
  },
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zhushanwen/pi-wool-shared": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhushanwen321/tai-ji-plugin.git",
    "directory": "packages/plugin-wool-trae"
  }
}
