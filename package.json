{
  "name": "tai-ji-plugin",
  "private": true,
  "version": "0.1.0",
  "description": "taiji plugin packages (pi provider extensions) — independent repo, npm release line decoupled from the taiji app version.",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "lint": "npx eslint packages/ test-guard/",
    "test": "pnpm -r --filter \"@zhushanwen/pi-*\" --filter \"@zhushanwen/plugin-*\" --workspace-concurrency=1 test",
    "changeset-version": "changeset version",
    "changeset-publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.0.0",
    "typescript-eslint": "^8.46.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3"
  }
}
